            function convertOctect2Humain(value) {
                if (value > 1000000000) {
                    return (value/1024/1024/1024).toFixed(2) + ' Go';
                }else if (value > 1000000) {
                    return (value/1024/1024).toFixed(2) + ' Mo';
                }else if (value > 1000) {
                    return (value/1024).toFixed(2) + ' Ko';
                } else {
                    return value;
